# Copy this file to .env and change the values for your machine.
# .env is ignored by Git. Never put tokens or passwords in this example file.

# Which machine this is: mac, gpu, demo, ci or company
MRAG_PROFILE=mac

# Model files live on the SSD, not the internal disk (WORK_PLAN.md section 6.3)
HF_HOME=/Volumes/MacbookAPFS/Project/.hf-cache

# Folder for private/, public/, annotations/ and the SQLite file. Relative to the repo root
MRAG_DATA_DIR=data

# Empty means SQLite at <data dir>/app.db. A PostgreSQL URL comes in step 15.3
MRAG_DATABASE_URL=

# llama-swap on the Mac. Port confirmed in step 0.3
MRAG_MODEL_SERVER_URL=http://127.0.0.1:8080/v1

# Qdrant in Docker (step 0.2)
MRAG_QDRANT_URL=http://127.0.0.1:6333

# MLflow (step 1.2). Port 5000 is taken by the macOS AirPlay Receiver
MRAG_MLFLOW_TRACKING_URI=http://127.0.0.1:5001
