# Copy this file to .env and change the values for your machine.
# .env is ignored by Git. Never put tokens or passwords in this example file.

# Which machine this is: mac, gpu, demo, ci or company
MRAG_PROFILE=mac

# Model files live on the SSD, not the internal disk (WORK_PLAN.md section 6.3)
HF_HOME=/Volumes/MacbookAPFS/Project/multiagent-ai-lab-local/hf-cache

# Folder for private/, public/, annotations/ and the SQLite file. Relative to the repo root
MRAG_DATA_DIR=data

# Empty means SQLite at <data dir>/app.db. A PostgreSQL URL here switches the database
MRAG_DATABASE_URL=

# llama-swap on the Mac (configs/llama-swap.yaml)
MRAG_MODEL_SERVER_URL=http://127.0.0.1:8080/v1

# Model server program and locally converted models (outside the repo, on the SSD)
MRAG_LLAMA_SERVER=/Volumes/MacbookAPFS/Project/multiagent-ai-lab-local/tools/llama.cpp-b11960/llama-server
MRAG_MODELS_DIR=/Volumes/MacbookAPFS/Project/multiagent-ai-lab-local/models

# Qdrant in Docker
MRAG_QDRANT_URL=http://127.0.0.1:6333

# MLflow. Port 5000 is taken by the macOS AirPlay Receiver
MRAG_MLFLOW_TRACKING_URI=http://127.0.0.1:5001
